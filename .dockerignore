# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/
backend/venv/
backend/.venv/

# Environment files (injected at runtime, not baked into image)
.env
backend/.env
backend/tests/.env.test

# Supabase runtime volumes — exclude the whole tree; postgres data dir is
# root-owned (mode 700) and unreadable by the build user, which makes
# BuildKit's context sender fail before .dockerignore narrows the walk.
backend/volumes

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
*.cover

# OS
.DS_Store
Thumbs.db

# Docs. A pattern without a folder only matches at the root, so this keeps the
# frontend's files. No "!" exceptions here: with one, BuildKit walks into
# excluded folders such as backend/volumes above and fails on their permissions.
*.md

# Dataset configs of real data: local only, mounted at run time, never in an image.
backend/plugins/*/datasets/local
